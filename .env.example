# --- Runtime -----------------------------------------------------------
APP_ENV=development            # development | test | production
LOG_LEVEL=INFO

# --- AI provider -------------------------------------------------------
# mock | xai | openai | openrouter | openai_compatible
AI_PROVIDER=mock
# Grok: set AI_PROVIDER=xai and create a key at https://console.x.ai
# Prefer a NON-reasoning model: reasoning tokens count against the output
# budget and can leave the visible answer empty. Check exact names at console.x.ai.
AI_MODEL=grok-4-fast-non-reasoning
AI_API_KEY=
# Optional. Defaults per provider (xai -> https://api.x.ai/v1). Required for openai_compatible.
AI_BASE_URL=
AI_TIMEOUT_SECONDS=20
AI_TEMPERATURE=0.3
# Some OpenAI-compatible servers only accept max_tokens
AI_MAX_TOKENS_PARAM=max_completion_tokens
# Estimated cost tracking (USD per 1M tokens). Fill from your provider's price list.
PRICE_PER_MILLION_INPUT_TOKENS=0
PRICE_PER_MILLION_OUTPUT_TOKENS=0

# --- Portfolio <-> chatbot link ---------------------------------------
# Comma-separated list of allowed browser origins (never "*")
PORTFOLIO_ORIGIN=http://localhost:3000
# Long random string shared ONLY with the portfolio SERVER (never NEXT_PUBLIC_*)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
PORTFOLIO_API_SECRET=

# --- Limits -----------------------------------------------------------
MAX_MESSAGE_LENGTH=1500
MAX_MESSAGES_PER_SESSION=20
MAX_OUTPUT_TOKENS=450
MAX_HISTORY_MESSAGES=10
SESSION_TTL_MINUTES=45
RATE_LIMIT_PER_MINUTE=8
VISITOR_DAILY_LIMIT=100
DAILY_REQUEST_LIMIT=1500
MAX_PAYLOAD_BYTES=8192

# --- Optional (Phase 8) ----------------------------------------------
REDIS_URL=
DATABASE_URL=

# --- Knowledge ---------------------------------------------------------
KNOWLEDGE_DIR=knowledge
